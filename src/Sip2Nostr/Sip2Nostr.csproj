<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Nostr.Sdk" Version="0.44.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime's own build/Whisper.net.Runtime.targets adds every
    Linux architecture's native library (linux-x64, linux-arm64, linux-arm)
    unconditionally whenever TargetFramework is a plain moniker like
    net8.0 - it never checks $(RuntimeIdentifier), unlike the standard
    NuGet runtimes/{rid}/native/ convention, which the SDK's own RID
    selection would otherwise prune automatically. Left alone, a
    single-file publish with IncludeNativeLibrariesForSelfExtract embeds
    all three into the one executable regardless of which single
    architecture that executable is actually for - it only filters by
    "loadable on this OS" (ELF vs PE vs Mach-O), not by CPU architecture.
    This drops the other two before they reach that step.

    Forward-compatible with an upstream fix: the Remove below only
    matches items whose TargetPath is exactly "runtimes/linux-*" for a
    *different* RID than the one being built. If a future
    Whisper.net.Runtime version starts conditioning these items on
    $(RuntimeIdentifier) itself (so only the matching one is ever added),
    or moves them to the standard runtimes/{rid}/native/ convention
    entirely, nothing here would still match - the Remove finds zero
    items and becomes a no-op, not a build failure. Worth deleting at
    that point for its own sake, but leaving it in stops being harmful
    the moment upstream stops needing it.
  -->
  <Target Name="ExcludeMismatchedLinuxWhisperNatives" BeforeTargets="AssignTargetPaths;ComputeResolvedFilesToPublishList"
          Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/linux-')) AND !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
    </ItemGroup>
  </Target>

</Project>
