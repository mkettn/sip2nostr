<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Nostr.Sdk" Version="0.44.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime's own build/Whisper.net.Runtime.targets adds every
    Linux architecture's native library (linux-x64, linux-arm64, linux-arm)
    unconditionally whenever TargetFramework is a plain moniker like
    net8.0 - it never checks $(RuntimeIdentifier), unlike the standard
    NuGet runtimes/{rid}/native/ convention, which the SDK's own RID
    selection would otherwise prune automatically. Left alone, a
    single-file publish with IncludeNativeLibrariesForSelfExtract embeds
    all three into the one executable regardless of which single
    architecture that executable is actually for - it only filters by
    "loadable on this OS" (ELF vs PE vs Mach-O), not by CPU architecture.
    This drops the other two Linux architectures before they reach that
    step. It does NOT touch the same package's win-x64/win-arm64/win-x86/
    macos-x64/macos-arm64 native libraries or its macOS-only Metal shader
    resource - those are added the same unconditional way but are never
    eligible for embedding into a Linux single-file binary in the first
    place (wrong file format for this OS), so there's nothing to prune
    them for; release.yml only moves the one binary out of the publish
    output afterward, so they're simply discarded there regardless.

    Forward-compatible with an upstream fix: the Remove below only
    matches items whose TargetPath is exactly "runtimes/linux-*" for a
    *different* RID than the one being built. If a future
    Whisper.net.Runtime version starts conditioning these items on
    $(RuntimeIdentifier) itself (so only the matching one is ever added),
    or moves them to the standard runtimes/{rid}/native/ convention
    entirely, nothing here would still match - the Remove finds zero
    items and becomes a no-op, not a build failure. Worth deleting at
    that point for its own sake, but leaving it in stops being harmful
    the moment upstream stops needing it.
  -->
  <Target Name="ExcludeMismatchedLinuxWhisperNatives" BeforeTargets="AssignTargetPaths;ComputeResolvedFilesToPublishList"
          Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/linux-')) AND !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
    </ItemGroup>
    <!--
      Guards against silently shipping a binary with no Whisper native at
      all for some future linux-* RID this project starts targeting that
      Whisper.net.Runtime doesn't - the Remove above can't tell "nothing
      matched because there was nothing to remove" from "nothing matched
      because there was never anything for this RID to begin with", so
      check explicitly rather than let that show up only as a runtime
      "native library not found" the first time delivery = "text" is used.
    -->
    <ItemGroup>
      <_RemainingWhisperNativesForRid Include="@(None)"
          Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
    </ItemGroup>
    <Error Condition="'@(_RemainingWhisperNativesForRid)' == ''"
           Text="Whisper.net.Runtime ships no native library for RuntimeIdentifier '$(RuntimeIdentifier)' - delivery = 'text' would fail to load it at first use instead of failing here at build time. Confirm Whisper.net.Runtime actually supports this RID before adding it to &lt;RuntimeIdentifiers&gt;." />
  </Target>

</Project>
