<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Nostr.Sdk" Version="0.44.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime's own build/Whisper.net.Runtime.targets adds every
    Linux architecture's native library (linux-x64, linux-arm64, linux-arm)
    unconditionally whenever TargetFramework is a plain moniker like
    net8.0 - it never checks $(RuntimeIdentifier), unlike the standard
    NuGet runtimes/{rid}/native/ convention. That leaves every
    architecture's copy sitting in out/<rid>/runtimes/ after a build, not
    just the one this RID needs - harmless, not something this needs to
    prune for correctness, since install.sh only ever copies
    runtimes/$(RuntimeIdentifier)/ out of that directory (see there).
    What actually matters is checking that this RID's own native library
    is really among what got shipped, and failing the build loudly if
    it's not, rather than leaving delivery = "text" to fail at first use
    with a runtime "native library not found".

    _WhisperLinuxNatives is captured separately from
    _WhisperNativeForRid so a future Whisper.net.Runtime version that
    stops shipping these as plain None items entirely - by moving to the
    standard runtimes/{rid}/native/ convention, say - reads as "this
    check no longer applies" (both empty, silent) rather than "no native
    for this RID" (a false failure blamed on the RID for what would
    actually be a fixed, differently-packaged upstream).
  -->
  <Target Name="RequireWhisperNativeForRid" BeforeTargets="AssignTargetPaths;ComputeResolvedFilesToPublishList"
          Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
    <ItemGroup>
      <_WhisperLinuxNatives Include="@(None)"
          Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/linux-'))" />
      <_WhisperNativeForRid Include="@(None)"
          Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/$(RuntimeIdentifier)/'))" />
    </ItemGroup>
    <Error Condition="'@(_WhisperLinuxNatives)' != '' AND '@(_WhisperNativeForRid)' == ''"
           Text="Whisper.net.Runtime ships no native library for RuntimeIdentifier '$(RuntimeIdentifier)' - delivery = 'text' would fail to load it at first use instead of failing here at build time. Confirm Whisper.net.Runtime actually supports this RID before adding it to &lt;RuntimeIdentifiers&gt;." />
  </Target>

</Project>
